# Copie este arquivo para .env e substitua a senha antes de iniciar a stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-local
STRESSER_BASE_URL=http://stresser-app:8080
STRESSER_TIMEOUT_SECONDS=2
EXPERIMENT_SEED=42
MAX_EXPERIMENT_DELAY_MS=2000

# Baseline k6 sob demanda; use um identificador novo a cada execução.
K6_BASE_URL=http://application-api:8000
K6_TEST_DURATION=30s
# Obrigatório ao executar k6; exemplo fictício: test-baseline-local-001.
# Pode ser informado com docker compose run -e K6_EXPERIMENT_RUN_ID=...
K6_EXPERIMENT_RUN_ID=
